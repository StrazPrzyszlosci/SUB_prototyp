# Zachowaj dokładne bajty źródeł i wyników objętych SHA-256.
* -text

# CSV z biblioteki csv używają CRLF, Markdown dopuszcza twarde łamanie spacjami.
*.csv whitespace=cr-at-eol
*.md whitespace=-blank-at-eol

# Wykresy SVG są generowanymi artefaktami Matplotlib.
*.svg whitespace=-blank-at-eol

# Materiały dostarczone przez użytkownika zachowujemy bez zmian bajtowych.
dane/zrodla/materialy_uzytkownika/* whitespace=-blank-at-eol,-blank-at-eof
